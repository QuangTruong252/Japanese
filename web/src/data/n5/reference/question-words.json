          "rows": [
            [
              "どう",
              {
                "en": "how (impression)",
                "vi": "thế nào (cảm nhận, ấn tượng)"
              },
              "日本[にほん]の 生活[せいかつ]はどうですか。"
            ],
            [
              "どうやって",
              {
                "en": "how (method)",
                "vi": "bằng cách nào / như thế nào (cách làm)"
              },
              "大学[だいがく]までどうやって 行[い]きますか。"
            ],
            [
              "どうして",
              {
                "en": "why",
                "vi": "tại sao"
              },
              "どうして 来[き]ませんでしたか。"
            ]
          ]
        }
      ],
      "note": {
        "en": "A question word + も with a negative verb negates everything: どこも 行[い]きません (I'm not going anywhere). A question word + か makes it indefinite: どこか (somewhere), 何[なに]か (something).",
        "vi": "Từ để hỏi + も kết hợp với động từ phủ định mang nghĩa phủ định hoàn toàn: どこも 行[い]きません (không đi bất cứ đâu). Từ để hỏi + か biến thành đại từ bất định: どこか (nơi nào đó), 何[なに]か (cái gì đó)."
      }
    }
